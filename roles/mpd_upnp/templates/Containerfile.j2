# Managed by Ansible (mpd_upnp role).
# Debian base because MPD and upmpdcli have no EL10 packages anywhere
# (EPEL 10, RPM Fusion EL10, COPR and upstream all checked) — in Debian
# both are first-class packages maintained for years.
FROM {{ mpd_upnp_debian_image }}

# upmpdcli is NOT in Debian's own archive (found out by building, not docs)
# — it comes from the developer's apt repo, which tracks Debian releases
# and is the upstream-documented install path.
#
# ca-certificates: MPD's curl input plugin needs it if Navidrome is served
# over HTTPS. mpc + alsa-utils are small and make in-container diagnosis
# (`podman exec mpd mpc status`, `aplay -l`) possible.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && curl -fsSL https://www.lesbonscomptes.com/pages/lesbonscomptes.gpg \
        -o /usr/share/keyrings/lesbonscomptes.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/lesbonscomptes.gpg] https://www.lesbonscomptes.com/upmpdcli/downloads/debian/ trixie main" \
        > /etc/apt/sources.list.d/upmpdcli.list \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        mpd \
        upmpdcli \
        mpc \
        alsa-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
